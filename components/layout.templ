package components

templ Layout(title string) {
  <html>
    <head>
      <title>{ title }</title>
      <link rel="preconnect" href="https://fonts.googleapis.com"/>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Space+Grotesk:wght@300..700&display=swap"/>
      <link rel="stylesheet" href="/static/reset.css"/>
      <link rel="stylesheet" href="/static/layout.css"/>
      <link rel="stylesheet" href="/static/style.css"/>
      <link rel="stylesheet" href="/static/post.css"/>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>
    <body>
      <main>
        <header class="header">
          <p class="logo">65bansekiのGoブログ</p>
        </header>
        { children... }
        <footer class="footer">
          <p>Copyright &copy; 2026 65banseki. All rights reserved.</p>
          <a href="https://github.com/hi-lee-mon/go-blog">GitHub</a>
        </footer>
      </main>
    </body>
  </html>
}
